{
  "name": "图溯开发预览",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "图溯完整功能预览",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt && python -m unittest -q",
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
