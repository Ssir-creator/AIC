[
  {
    "start": 1.288,
    "end": 7.592,
    "text": "图溯面向人工智能图像生成平台和内容生产企业，"
  },
  {
    "start": 7.592,
    "end": 13.323,
    "text": "提供水印嵌入、来源登记与传播后核验服务。"
  },
  {
    "start": 13.323,
    "end": 17.335,
    "text": "下面展示当前网站的真实操作。"
  },
  {
    "start": 19.338,
    "end": 24.677,
    "text": "网站的核心入口是生成带球形水印的图片。"
  },
  {
    "start": 24.677,
    "end": 27.206,
    "text": "用户可以描述画面，"
  },
  {
    "start": 27.206,
    "end": 30.579,
    "text": "填写业务编号和公开范围。"
  },
  {
    "start": 30.579,
    "end": 35.356,
    "text": "当前录制环境没有配置球形水印模型，"
  },
  {
    "start": 35.356,
    "end": 38.447,
    "text": "因此这里展示接入入口，"
  },
  {
    "start": 38.447,
    "end": 41.538,
    "text": "不展示虚构的生成结果。"
  },
  {
    "start": 43.54,
    "end": 46.314,
    "text": "为演示完整业务流程，"
  },
  {
    "start": 46.314,
    "end": 52.419,
    "text": "接下来使用已有图片辅助处理中的本地演示水印。"
  },
  {
    "start": 52.419,
    "end": 54.361,
    "text": "上传演示素材，"
  },
  {
    "start": 54.361,
    "end": 57.69,
    "text": "填写内容名称与来源声明，"
  },
  {
    "start": 57.69,
    "end": 60.465,
    "text": "并允许公开来源信息。"
  },
  {
    "start": 60.465,
    "end": 63.795,
    "text": "这里使用的不是球形水印，"
  },
  {
    "start": 63.795,
    "end": 66.57,
    "text": "也不是模型生成图片。"
  },
  {
    "start": 68.57300000000001,
    "end": 70.242,
    "text": "点击处理后，"
  },
  {
    "start": 70.242,
    "end": 73.303,
    "text": "服务实际写入隐形标识，"
  },
  {
    "start": 73.303,
    "end": 75.529,
    "text": "并生成关联记录。"
  },
  {
    "start": 75.529,
    "end": 78.59,
    "text": "页面展示处理前后图片，"
  },
  {
    "start": 78.59,
    "end": 80.538,
    "text": "保留原始素材，"
  },
  {
    "start": 80.538,
    "end": 83.599,
    "text": "同时提供交付图片下载。"
  },
  {
    "start": 83.599,
    "end": 86.66,
    "text": "登记声明用于来源核对，"
  },
  {
    "start": 86.66,
    "end": 89.44200000000001,
    "text": "不直接证明版权归属。"
  },
  {
    "start": 91.444,
    "end": 94.148,
    "text": "在内容与来源记录中，"
  },
  {
    "start": 94.148,
    "end": 101.988,
    "text": "可以查询图片对应的业务编号、平台声明、标识方式和登记时间。"
  },
  {
    "start": 101.988,
    "end": 106.043,
    "text": "每条内容都能独立设置公开范围，"
  },
  {
    "start": 106.043,
    "end": 111.18,
    "text": "内部任务信息不会出现在公开核验结果中。"
  },
  {
    "start": 113.182,
    "end": 118.0,
    "text": "现在切换到无需登录的公开核验入口，"
  },
  {
    "start": 118.0,
    "end": 121.967,
    "text": "重新上传刚刚下载的交付图片。"
  },
  {
    "start": 121.967,
    "end": 126.502,
    "text": "系统检测标识并匹配公开登记记录，"
  },
  {
    "start": 126.502,
    "end": 130.752,
    "text": "展示内容名称、登记平台和时间。"
  },
  {
    "start": 130.752,
    "end": 132.453,
    "text": "未检出水印，"
  },
  {
    "start": 132.453,
    "end": 136.987,
    "text": "不代表图片一定不是人工智能生成。"
  },
  {
    "start": 138.988,
    "end": 143.252,
    "text": "企业控制台还提供效果测试工具。"
  },
  {
    "start": 143.252,
    "end": 146.662,
    "text": "这里将图片进行明显压缩，"
  },
  {
    "start": 146.662,
    "end": 148.936,
    "text": "再实际检测标识。"
  },
  {
    "start": 148.936,
    "end": 152.631,
    "text": "页面上的结果来自本次运行，"
  },
  {
    "start": 152.631,
    "end": 158.316,
    "text": "仅说明这张演示图在当前处理条件下的表现，"
  },
  {
    "start": 158.316,
    "end": 162.57999999999998,
    "text": "不能作为球形水印的鲁棒性成绩。"
  },
  {
    "start": 164.941,
    "end": 167.993,
    "text": "企业可以创建应用密钥，"
  },
  {
    "start": 167.993,
    "end": 170.767,
    "text": "把图溯接入已有业务。"
  },
  {
    "start": 170.767,
    "end": 174.373,
    "text": "完整密钥在录像中已经遮挡。"
  },
  {
    "start": 174.373,
    "end": 177.424,
    "text": "这里发送真实接口请求，"
  },
  {
    "start": 177.424,
    "end": 180.753,
    "text": "验证身份认证与记录读取，"
  },
  {
    "start": 180.753,
    "end": 182.973,
    "text": "再查看调用日志。"
  },
  {
    "start": 182.973,
    "end": 187.966,
    "text": "未启用的计费能力不会显示为实际收入。"
  },
  {
    "start": 190.257,
    "end": 192.212,
    "text": "对于多张图片，"
  },
  {
    "start": 192.212,
    "end": 196.122,
    "text": "网站支持批量提交并顺序处理，"
  },
  {
    "start": 196.122,
    "end": 199.195,
    "text": "每张图片分别展示结果。"
  },
  {
    "start": 199.195,
    "end": 203.38400000000001,
    "text": "企业也可以批量核验并下载报告。"
  },
  {
    "start": 203.38400000000001,
    "end": 210.087,
    "text": "这样可以把单张图片的操作扩展到日常素材管理流程。"
  },
  {
    "start": 212.091,
    "end": 220.458,
    "text": "本次演示走通了图片处理、登记、下载、再次核验与企业接入流程。"
  },
  {
    "start": 220.458,
    "end": 224.084,
    "text": "实际使用的是内置演示水印。"
  },
  {
    "start": 224.084,
    "end": 227.43099999999998,
    "text": "后续接入球形水印模型后，"
  },
  {
    "start": 227.43099999999998,
    "end": 233.847,
    "text": "还需要单独验证生成质量、来源恢复和传播鲁棒性。"
  }
]